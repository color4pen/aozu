{"type":"lineage","step":"design","ts":"2026-07-02T03:34:22.453Z","outputs":[{"path":"specrunner/changes/graph-and-check/design.md","hash":"sha256:b6fa333df079420f0f1b6f729235f13464885e369bf721918765ed7abbd57123"},{"path":"specrunner/changes/graph-and-check/tasks.md","hash":"sha256:28afa664bc853275ef73821b8dbbb8d1a77a16db17befed1415b8a6facdf6600"},{"path":"specrunner/changes/graph-and-check/spec.md","hash":"sha256:28b7faeb256dea7cfdebc6d2b969eaec82e2ef68ebf6125ce8e926b548389fff"}],"inputs":[{"path":"specrunner/changes/graph-and-check/request.md","hash":"sha256:4ee3d0f866c5f92223ecf40987c2c5ffd2bf92748a454a512524fbc735410b06"}]}
